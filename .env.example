# EmailJS Configuration
# Get these values from your EmailJS dashboard: https://www.emailjs.com/
VITE_EMAIL_SERVICE=your_service_id_here
VITE_EMAIL_TEMPLATE=your_template_id_here
VITE_EMAIL_COTIZADOR=your_cotizador_template_id_here
VITE_EMAIL_USER=your_public_key_here

# Supabase Configuration
# Get these values from your Supabase project: https://supabase.com/
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Core FastAPI (Parte 2 — emisión y pago)
# Backend delgado en api/*: si MOCK_CORE=true (o no hay CORE_BASE_URL) usa
# respuestas simuladas para la demo. En producción, apuntar al core real.
CORE_BASE_URL=
CORE_API_KEY=
MOCK_CORE=true

# Instructions:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual credentials
# 3. Make sure .env is added to .gitignore (already configured)
# 4. VITE_EMAIL_COTIZADOR es para las cotizaciones del chatbot de microseguros
# 5. Supabase URL y Key los encuentras en Settings > API en tu proyecto de Supabase
